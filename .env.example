# Telegram bot
BOT_TOKEN=123456:ABC-DEF...

# Google Drive OAuth
G_DRIVE_CLIENT_ID=your-client-id.apps.googleusercontent.com
G_DRIVE_CLIENT_SECRET=your-client-secret

# Optional: service-account JSON key (alternative to OAuth)
# G_DRIVE_CLIENT_SECRET_SA={"type":"service_account","client_email":"...","private_key":"..."}

# Storage & limits
DOWNLOAD_DIRECTORY=./downloads/
DATA_DIR=./data/
MAX_MIRROR_FILE_SIZE=10737418240
MAX_CONCURRENT_MIRRORS=2

# Access control (space or comma separated Telegram user IDs; empty = allow all)
SUDO_USERS=

# Auth mode: oauth | service_account
DEFAULT_AUTH_MODE=oauth

# Long-poll timeout
POLL_TIMEOUT_SECONDS=30

# yt-dlp binary (for /ytdl); resolved from PATH when empty
# YTDLP_BIN=/usr/local/bin/yt-dlp
